#!/usr/bin/env zsh
set -euo pipefail

# Manage symlinks from zsh-users/zsh-completions into site-functions (run compsync help).

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/compsync"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/compsync"
SOURCE_URL="https://github.com/zsh-users/zsh-completions.git"
SOURCE_DIR="$DATA_DIR/source"
STATE_FILE="$STATE_DIR/list"

TARGET_DIR="/usr/local/share/zsh/site-functions"

mkdir -p "$DATA_DIR"
mkdir -p "$STATE_DIR"

# source management
update_source() {
  if [[ -d "$SOURCE_DIR/.git" ]]; then
    git -C "$SOURCE_DIR" pull --ff-only --quiet
  else
    git clone --depth 1 --quiet "$SOURCE_URL" "$SOURCE_DIR"
  fi
}

# helpers
exists_in_source() {
  [[ -f "$SOURCE_DIR/src/_$1" ]]
}

ensure_state_file() {
  touch "$STATE_FILE"
}

sort_state_file() {
  [[ -f "$STATE_FILE" ]] || return 0
  local tmp="${STATE_FILE}.tmp"
  LC_ALL=C sort -u "$STATE_FILE" -o "$tmp"
  mv "$tmp" "$STATE_FILE"
}

in_list() {
  grep -qx "$1" "$STATE_FILE" 2>/dev/null
}

add_to_list() {
  in_list "$1" || echo "$1" >> "$STATE_FILE"
}

remove_from_list() {
  [[ -f "$STATE_FILE" ]] || return 0
  local tmp="${STATE_FILE}.tmp"
  : >"$tmp"
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "$1" ]] && continue
    [[ -z "$line" ]] && continue
    print -r -- "$line" >>"$tmp"
  done <"$STATE_FILE"
  mv "$tmp" "$STATE_FILE"
}

link_completion() {
  sudo ln -sf "$SOURCE_DIR/src/_$1" "$TARGET_DIR/_$1"
}

unlink_completion() {
  sudo rm -f "$TARGET_DIR/_$1"
}

# commands
cmd_list() {
  ensure_state_file
  sort_state_file

  while read -r item; do
    [[ -z "$item" ]] && continue
    print -r -- "$item"
  done <"$STATE_FILE"
}

cmd_add() {
  [[ $# -eq 0 ]] && {
    print -r -- "usage: compsync add <name> ..." >&2
    return 1
  }

  update_source

  local name
  for name in "$@"; do
    if ! exists_in_source "$name"; then
      print -r -- "not found in source: $name" >&2
      exit 1
    fi
    ensure_state_file
    add_to_list "$name"
    link_completion "$name"
  done
  sort_state_file
}

cmd_remove() {
  [[ $# -eq 0 ]] && {
    print -r -- "usage: compsync remove <name> ..." >&2
    return 1
  }

  ensure_state_file

  local name
  for name in "$@"; do
    if ! in_list "$name"; then
      print -r -- "not in list: $name" >&2
      return 1
    fi
    unlink_completion "$name"
    remove_from_list "$name"
  done
}

cmd_update() {
  update_source
}

cmd_doctor() {
  print -r -- "DATA_DIR=$DATA_DIR"
  print -r -- "STATE_DIR=$STATE_DIR"
  print -r -- "SOURCE_DIR=$SOURCE_DIR"
  print -r -- "TARGET_DIR=$TARGET_DIR"
  if [[ -d "$SOURCE_DIR/src" ]]; then
    local -a files=("$SOURCE_DIR"/src/_*(N))
    if (( ${#files} )); then
      print -r -- "source: ok (${#files} completions under src/)"
    else
      print -r -- "source: clone present but src/ has no _* files (try: compsync update)"
    fi
  else
    print -r -- "source: missing (run: compsync update)"
  fi
  if [[ -w "$TARGET_DIR" ]]; then
    print -r -- "target: directory writable"
  else
    print -r -- "target: not writable by this user (add/remove use sudo ln)"
  fi
}

cmd_help() {
  cat <<EOF
compsync — zsh-users/zsh-completions → $TARGET_DIR

Usage: compsync <command> [args]

Commands
  list       Print tracked basenames from the state file (sorted, unique).
  add        Symlink clone src/_<name> here (sudo). Basename must exist in clone (run update first).
  remove     Remove symlink and drop basename from state (sudo).
  update     Clone or pull the completion repo into the source dir.
  doctor     Print paths and clone/target hints.
  help       Show help.

Locations
  source  $SOURCE_DIR
  state   $STATE_FILE
EOF
}

# router
cmd="${1:-help}"
(( $# )) && shift

case "$cmd" in
  list) cmd_list ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  update) cmd_update ;;
  doctor) cmd_doctor ;;
  help|*) cmd_help ;;
esac
