#!/usr/bin/env zsh
set -euo pipefail

# Manage symlinks from zsh-users/zsh-completions into site-functions (run compsync help).

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/compsync"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/compsync"
SOURCE_URL="https://github.com/zsh-users/zsh-completions.git"
SOURCE_DIR="$DATA_DIR/source"
STATE_FILE="$STATE_DIR/list"

TARGET_DIR="/usr/local/share/zsh/site-functions"

mkdir -p "$DATA_DIR"
mkdir -p "$STATE_DIR"

# source management
update_source() {
  if [[ -d "$SOURCE_DIR/.git" ]]; then
    git -C "$SOURCE_DIR" pull --ff-only --quiet
  else
    git clone --depth 1 --quiet "$SOURCE_URL" "$SOURCE_DIR"
  fi
}

# helpers
exists_in_source() {
  [[ -f "$SOURCE_DIR/src/_$1" ]]
}

is_installed() {
  [[ -L "$TARGET_DIR/_$1" ]]
}

ensure_state_file() {
  touch "$STATE_FILE"
}

sort_state_file() {
  [[ -f "$STATE_FILE" ]] || return 0
  local tmp="${STATE_FILE}.tmp"
  LC_ALL=C sort -u "$STATE_FILE" -o "$tmp"
  mv "$tmp" "$STATE_FILE"
}

in_list() {
  grep -qx "$1" "$STATE_FILE" 2>/dev/null
}

add_to_list() {
  in_list "$1" || echo "$1" >> "$STATE_FILE"
}

remove_from_list() {
  [[ -f "$STATE_FILE" ]] || return 0
  local tmp="${STATE_FILE}.tmp"
  : >"$tmp"
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "$1" ]] && continue
    [[ -z "$line" ]] && continue
    print -r -- "$line" >>"$tmp"
  done <"$STATE_FILE"
  mv "$tmp" "$STATE_FILE"
}

link_completion() {
  sudo ln -sf "$SOURCE_DIR/src/_$1" "$TARGET_DIR/_$1"
}

unlink_completion() {
  sudo rm -f "$TARGET_DIR/_$1"
}

# commands
cmd_list() {
  ensure_state_file
  sort_state_file

  while read -r item; do
    [[ -z "$item" ]] && continue

    if is_installed "$item"; then
      print -r -- "✔ $item"
    else
      print -r -- "✖ $item"
    fi
  done < "$STATE_FILE"
}

cmd_find() {
  if [[ ! -d "$SOURCE_DIR/src" ]]; then
    print -r -- "compsync: local source missing (no $SOURCE_DIR/src)" >&2
    print -r -- "  run: compsync update" >&2
    print -r -- "  or:  compsync doctor" >&2
    exit 1
  fi

  local -a files=("$SOURCE_DIR"/src/_*(N))
  if (( ! ${#files} )); then
    print -r -- "compsync: no completion files under $SOURCE_DIR/src" >&2
    print -r -- "  run: compsync update" >&2
    print -r -- "  or:  compsync doctor" >&2
    exit 1
  fi

  local -a names=()
  local f
  for f in "${files[@]}"; do
    names+=("${${f:t}#_}")
  done
  names=("${(@ou)names}")

  local arg="${1:-}"
  if [[ "$arg" == "--all" ]]; then
    print -rl -- "${names[@]}"
    return
  fi

  if [[ -z "$arg" ]]; then
    print -r -- "usage: compsync find <name>|--all" >&2
    return 1
  fi

  printf '%s\n' "${names[@]}" | grep -Fi "$arg" || true
}

cmd_add() {
  [[ $# -eq 0 ]] && {
    print -r -- "usage: compsync add <name> ..." >&2
    return 1
  }

  update_source

  local name
  for name in "$@"; do
    if ! exists_in_source "$name"; then
      print -r -- "not found in source: $name" >&2
      exit 1
    fi
    ensure_state_file
    add_to_list "$name"
    link_completion "$name"
  done
  sort_state_file
}

cmd_remove() {
  [[ $# -eq 0 ]] && {
    print -r -- "usage: compsync remove <name> ..." >&2
    return 1
  }

  ensure_state_file

  local name
  for name in "$@"; do
    if ! in_list "$name"; then
      print -r -- "not in list: $name" >&2
      return 1
    fi
    unlink_completion "$name"
    remove_from_list "$name"
  done
}

cmd_update() {
  update_source
}

cmd_link() {
  ensure_state_file
  local item
  while read -r item; do
    [[ -z "$item" ]] && continue
    if exists_in_source "$item"; then
      link_completion "$item"
    else
      print -r -- "skip (not in source): $item" >&2
    fi
  done <"$STATE_FILE"
}

cmd_unlink() {
  ensure_state_file
  local item
  while read -r item; do
    [[ -z "$item" ]] && continue
    unlink_completion "$item"
  done <"$STATE_FILE"
}

cmd_sync() {
  update_source
  ensure_state_file
  local item
  while read -r item; do
    [[ -z "$item" ]] && continue
    if exists_in_source "$item"; then
      link_completion "$item"
    else
      print -r -- "skip (not in source): $item" >&2
    fi
  done <"$STATE_FILE"
}

cmd_doctor() {
  print -r -- "DATA_DIR=$DATA_DIR"
  print -r -- "STATE_DIR=$STATE_DIR"
  print -r -- "SOURCE_DIR=$SOURCE_DIR"
  print -r -- "TARGET_DIR=$TARGET_DIR"
  if [[ -d "$SOURCE_DIR/src" ]]; then
    local -a files=("$SOURCE_DIR"/src/_*(N))
    if (( ${#files} )); then
      print -r -- "source: ok (${#files} completions under src/)"
    else
      print -r -- "source: clone present but src/ has no _* files (try: compsync update)"
    fi
  else
    print -r -- "source: missing (run: compsync update)"
  fi
  if [[ -w "$TARGET_DIR" ]]; then
    print -r -- "target: directory writable"
  else
    print -r -- "target: not writable by this user (add/link/sync use sudo ln)"
  fi
}

cmd_help() {
  cat <<EOF
compsync — install completions from zsh-users/zsh-completions into:
  $TARGET_DIR

Usage: compsync <command> [arguments]

Commands
  list               Lines in your state file; ✔ = symlink present, ✖ = not.
  find <text>        Names in the local clone whose names contain <text> (anywhere,
                     case-insensitive). Does not change disk.
  find --all         Every completion basename from the clone (sorted).
  add <name> …       Append names to state and symlink src/_<name> here (uses sudo).
                     Names must match repo files exactly — use find first.
  remove <name> …    Remove symlinks and drop names from state (uses sudo).
  update             Git clone (first time) or pull the completion source tree.
  sync               Same as update, then link every name in state.
  link               Link every name in state (no git).
  unlink             Remove symlinks for every name in state (no git).
  doctor             Paths, whether the clone and src/ exist, target writable?
  help               Show this message.

Locations
  source   $SOURCE_DIR
  state    $STATE_FILE   (one basename per line, sorted)
EOF
}

# router
cmd="${1:-help}"
(( $# )) && shift

case "$cmd" in
  list) cmd_list ;;
  find) cmd_find "$@" ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  update) cmd_update ;;
  sync) cmd_sync ;;
  link) cmd_link ;;
  unlink) cmd_unlink ;;
  doctor) cmd_doctor ;;
  help|*) cmd_help ;;
esac
