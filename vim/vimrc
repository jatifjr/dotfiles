" Packs
let s:dir = split(&packpath, ',')[0] . '/pack/plugins/start/'
let s:repos = [
  \ 'tpope/vim-commentary',
  \ 'tpope/vim-sensible',
  \ 'tpope/vim-sleuth',
  \ ]

function! s:Sync(update) abort
  for l:repo in s:repos
    let l:path = s:dir . fnamemodify(l:repo, ':t')
    if isdirectory(l:path)
      if !a:update
        continue
      endif
      let l:cmd = 'git -C ' . shellescape(l:path) . ' pull --ff-only'
    else
      let l:cmd = 'git clone --depth 1 https://github.com/' . l:repo
        \ . ' ' . shellescape(l:path)
    endif
    echo l:repo . ': ' . trim(system(l:cmd))
    silent! execute 'helptags' fnameescape(l:path . '/doc')
  endfor
endfunction

command! PackUpdate call s:Sync(1)

if executable('git')
  call s:Sync(0)
endif

packloadall


" Options
set nobackup
set noswapfile
set viminfo+=n~/.local/state/viminfo
set mouse=a
set clipboard=unnamed
set number


" Theme
set t_Co=16
silent! colorscheme quiet
