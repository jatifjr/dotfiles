{
  // Zed settings
  //
  // For information on how to configure Zed, see the Zed//zed.dev/docs/configuring-zed
  //
  // To see all of Zed's default settings without changing your
  // custom settings, run `zed: open default settings` from the
  // command palette (cmd-shift-p / ctrl-shift-p)
  "agent": {
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "dock": "left",
    "default_model": {
      "effort": "high",
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "status_bar": {
    "show_active_file": true,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte (Blur) [Light]",
    "dark": "Catppuccin Espresso (Blur) [Light]",
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 14.0,
  "buffer_font_family": "SF Mono",
  "buffer_font_size": 12.0,
  "session": {
    "trust_all_worktrees": true,
  },
  "cli_default_open_behavior": "new_window",
  "base_keymap": "VSCode",
  "vim_mode": true,
}
