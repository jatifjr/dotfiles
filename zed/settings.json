  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "status_bar": {
    "show_active_file": true,
  },
  "tab_bar": {
    "show": false,
