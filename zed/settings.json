  "agent": {
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "dock": "left",
    "default_model": {
      "provider": "opencode",
      "model": "free/big-pickle",
      "enable_thinking": false,
    },
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "openrouter/free",
        "enable_thinking": true
      },
      {
        "provider": "opencode",
        "model": "free/big-pickle",
        "enable_thinking": false
      }
    ],
